# Copier ce fichier vers .env et remplir les valeurs.
# Le fichier .env est gitignored — ne JAMAIS le committer.

# === PostgreSQL ===
# Variables utilisees par docker-compose.yml ET Spring Boot (application.yml)
POSTGRES_DB=app_db
POSTGRES_USER=appmanagement
POSTGRES_PASSWORD=change-me-in-local

# === Connexion Spring Boot a la DB ===
DB_HOST=localhost
DB_PORT=5432

# === pgAdmin (uniquement pour le dev local) ===
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-in-local

# === Serveur Spring Boot ===
SERVER_PORT=8080
